# Our Canvas — environment
# The one shared password for the canvas: exactly 8 digits.
# On Render: Dashboard → your service → Environment → add CANVAS_PASSWORD.
# Example only — pick your own 8 digits.
CANVAS_PASSWORD=12345678

# Durable storage (Neon Postgres). Without this, drawings live in ./data/*.json
# and are wiped on Render redeploys. With it, canvas + sessions + bans persist.
# On Render: Dashboard → your service → Environment → add DATABASE_URL.
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require
